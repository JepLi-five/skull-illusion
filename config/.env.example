# 私有平台环境变量样例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）

# DeepSeek API Key（重活推理用，兼容 OpenAI 协议）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 本地小模型端点（轻活/离线兜底，可选；如已装 Ollama）
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama

# Goose 二进制路径（Windows）
GOOSE_BIN=tools/goose/goose.exe

# 数据库路径
SKULL_DB=data/skull.db
